+++ b/app/src/main/java/app/revanced/manager/util/SplitApkMerger.kt
@@ -0,0 +1,124 @@
+package app.revanced.manager.util
+
+import android.content.pm.ApplicationInfo
+import android.util.Log
+import com.reandroid.apk.APKLogger
+import com.reandroid.apk.ApkBundle
+import com.reandroid.apk.ApkModule
+import com.reandroid.arsc.chunk.xml.ResXmlElement
+import java.io.File
+
+/**
+ * Fusionne une application installée en APK splittés (bundle du Play Store) en un APK
+ * unique, utilisable comme source de patch.
+ *
+ * La fusion repose sur ARSCLib (bibliothèque d'APKEditor) : ressources, dex et
+ * bibliothèques natives des splits sont regroupés dans le module de base, puis les
+ * déclarations propres aux splits sont retirées du manifeste pour que l'APK obtenu
+ * puisse s'installer seul.
+ */
+object SplitApkMerger {
+    const val MERGED_APK_NAME = "merged-source.apk"
+
+    // Identifiants des attributs android:* (android.R.attr), en dur car certains
+    // n'existent qu'à partir d'API récentes.
+    private const val ATTR_NAME = 0x01010003
+    private const val ATTR_IS_SPLIT_REQUIRED = 0x01010591
+    private const val ATTR_REQUIRED_SPLIT_TYPES = 0x0101064e
+    private const val ATTR_SPLIT_TYPES = 0x0101064f
+
+    private val signatureFiles = Regex("^META-INF/.+\\.(MF|SF|RSA|DSA|EC)$").toPattern()
+
+    /** Métadonnées ajoutées par le Play Store qui imposent la présence des splits. */
+    private val splitMetaData = setOf(
+        "com.android.vending.splits.required",
+        "com.android.vending.splits",
+        "com.android.vending.derived.apk.id",
+        "com.android.stamp.source",
+        "com.android.stamp.type",
+        "com.android.dynamic.apk.fused.modules",
+    )
+
+    fun ApplicationInfo.isSplit() = !splitSourceDirs.isNullOrEmpty()
+
+    /**
+     * Retourne l'APK à patcher pour une application installée : son base.apk s'il est
+     * autonome, sinon un APK fusionné écrit dans [outputDir].
+     */
+    fun sourceFor(appInfo: ApplicationInfo, outputDir: File): File {
+        if (!appInfo.isSplit()) return File(appInfo.sourceDir)
+
+        val apks = listOf(File(appInfo.sourceDir)) + appInfo.splitSourceDirs.orEmpty().map(::File)
+        return File(outputDir, MERGED_APK_NAME).also { merge(apks, it) }
+    }
+
+    /**
+     * Fusionne [apks] (le base.apk en premier, puis les splits) dans [output].
+     */
+    fun merge(apks: List<File>, output: File, logger: APKLogger = AndroidLogger) {
+        require(apks.isNotEmpty()) { "Aucun APK à fusionner" }
+        output.delete()
+
+        ApkBundle().use { bundle ->
+            bundle.setAPKLogger(logger)
+            apks.forEachIndexed { index, apk ->
+                // Le nom de module doit être unique ; « base » désigne le module principal.
+                val name = if (index == 0) "base" else apk.nameWithoutExtension
+                bundle.addModule(ApkModule.loadApkFile(apk, name).apply { setAPKLogger(logger) })
+            }
+
+            bundle.mergeModules(false).use { merged ->
+                // L'ancienne signature ne correspond plus au contenu fusionné.
+                merged.zipEntryMap.removeIf(signatureFiles)
+                merged.zipEntryMap.remove("stamp-cert-sha256")
+                merged.setApkSignatureBlock(null)
+                sanitizeManifest(merged)
+                merged.refreshTable()
+                merged.refreshManifest()
+                // Les bibliothèques natives ne sont plus dans un split dédié : on laisse
+                // Android les extraire à l'installation.
+                merged.setExtractNativeLibs(true)
+                merged.writeApk(output)
+            }
+        }
+
+        logger.logMessage("APK fusionné : ${output.absolutePath} (${apks.size} fichiers)")
+    }
+
+    private fun sanitizeManifest(module: ApkModule) {
+        if (!module.hasAndroidManifest()) return
+        val manifest = module.androidManifest
+
+        manifest.manifestElement?.apply {
+            removeAttributesWithId(ATTR_IS_SPLIT_REQUIRED)
+            removeAttributesWithId(ATTR_REQUIRED_SPLIT_TYPES)
+            removeAttributesWithId(ATTR_SPLIT_TYPES)
+            removeAttributesWithName("requiredSplitTypes")
+            removeAttributesWithName("splitTypes")
+        }
+
+        manifest.applicationElement?.apply {
+            removeAttributesWithId(ATTR_IS_SPLIT_REQUIRED)
+            removeElementsIf { element ->
+                element is ResXmlElement && element.name == "meta-data" &&
+                    element.searchAttributeByResourceId(ATTR_NAME)?.valueString in splitMetaData
+            }
+        }
+    }
+
+    private object AndroidLogger : APKLogger {
+        private const val TAG = "SplitApkMerger"
+
+        override fun logMessage(msg: String) {
+            Log.i(TAG, msg)
+        }
+
+        override fun logError(msg: String, tr: Throwable?) {
+            Log.e(TAG, msg, tr)
+        }
+
+        override fun logVerbose(msg: String) {
+            Log.v(TAG, msg)
+        }
+    }
+}
