# Dépôt officiel suivi.
UPSTREAM_REPO=ReVanced/revanced-manager

# Tag officiel sur lequel les fichiers de patches/ ont été écrits. Sert de base au
# repli « 3-way » quand une nouvelle version a modifié les lignes voisines.
BASE_TAG=v2.7.0-dev.11

# Identifiant et nom de l'application construite. Différents de l'officiel pour que
# les deux Managers puissent être installés côte à côte.
APPLICATION_ID=app.revanced.manager.bundle
APP_NAME="ReVanced Manager Bundle"
